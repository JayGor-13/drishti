# Same as Dockerfile.yolo but with Ultralytics 8.4 (needed only for YOLO26).
# Build:  docker build -t drishti-yolo26:latest -f dgx/Dockerfile.yolo26 dgx
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir "ultralytics>=8.4.0,<8.5" numpy pillow pyyaml tqdm matplotlib psutil pytest

ENV PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg \
    MPLCONFIGDIR=/tmp/mpl \
    YOLO_CONFIG_DIR=/tmp/yolo \
    HOME=/tmp
WORKDIR /workspace/code
